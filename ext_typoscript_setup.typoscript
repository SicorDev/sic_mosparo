plugin.tx_powermail {
	view {
		partialRootPaths {
			10 = EXT:sic_mosparo/Resources/Private/Partials/
		}
	}
	settings.setup {
		mosparo {
            publickey = {$plugin.tx_sicmosparo.publickey}
            host = {$plugin.tx_sicmosparo.host}
            uid = {$plugin.tx_sicmosparo.uid}
        }
		spamshield.methods {
			# Add mosparo spamcheck
			10 {
				_enable = 1

				# Spamcheck name
				name = Mosparo Captcha

				# Class
				class = SICOR\SicMosparo\Domain\Validator\SpamShield\MosparoMethod

				# if this check failes - add this indication value to indicator (0 disables this check completely)
				indication = 10

				# method configuration
				configuration {
					privatekey = {$plugin.tx_sicmosparo.privatekey}
					publickey = {$plugin.tx_sicmosparo.publickey}
					host = {$plugin.tx_sicmosparo.host}
					uid = {$plugin.tx_sicmosparo.uid}
				}
			}
		}
	}
}
